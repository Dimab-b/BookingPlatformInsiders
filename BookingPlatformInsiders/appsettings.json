{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AllowedHosts": "*",
  "BackgroundJobs": {
    "AutoComplete": {
      "Cron": "*/5 * * * *",
      "BatchSize": 100,
      "MaxBatches": 10
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Hangfire": {
    "SchemaName": "hangfire"
  }
}
