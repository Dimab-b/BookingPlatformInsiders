{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AllowedHosts": "*",
  "BackgroundJobs": {
    "AutoComplete": {
      "Cron": "*/5 * * * *",
      "BatchSize": 100,
      "MaxBatches": 10
    }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173"
    ]
  },
  "Jwt": {
    "Issuer": "BookingPlatformInsiders",
    "Audience": "BookingPlatformInsiders.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Auth": {
    "RefreshCookieName": "refresh_token",
    "RefreshCookiePath": "/api/auth",
    "RequireSecureCookies": false,
    "RefreshCookieSameSite": "Lax"
  },
  "Hangfire": {
    "SchemaName": "hangfire"
  }
}
